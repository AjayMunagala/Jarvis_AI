    {
      "model_key": "openai-compatible-configured",
      "provider": "openai",
      "model_id": "${JARVIS_OPENAI_MODEL}",
      "display_name": "Configured OpenAI-compatible model",
      "task_types": ["general"],
      "input_modalities": ["text"],
      "tool_calling": false,
      "structured_output": true,
      "locality": "remote",
      "requires": ["JARVIS_PROVIDER=openai", "JARVIS_OPENAI_API_KEY"],
      "limitations": [
