JARVIS_APP_NAME=JARVIS Core
JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO
JARVIS_PROVIDER=mock
# Set to openai to use the optional OpenAI-compatible Chat Completions adapter.
# When selected, set JARVIS_OPENAI_API_KEY in your local, git-ignored .env file.
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_OPENAI_MODEL=gpt-4o-mini
JARVIS_PROVIDER_CONNECT_TIMEOUT_SECONDS=2
JARVIS_PROVIDER_READ_TIMEOUT_SECONDS=30
JARVIS_REQUEST_TIMEOUT_SECONDS=5
JARVIS_MAX_MESSAGE_LENGTH=4000
JARVIS_MAX_REQUEST_BODY_BYTES=65536
JARVIS_MAX_TOOL_ROUNDS=5
JARVIS_MAX_EXPERT_RETRIES=2
JARVIS_MAX_PARALLEL_EXPERTS=2
# Optional conversation persistence; disabled by default. Install with: pip install -e ".[persistence]"
JARVIS_PERSISTENCE_ENABLED=false
JARVIS_PERSISTENCE_CONNECT_TIMEOUT_SECONDS=3
JARVIS_PERSISTENCE_OPERATION_TIMEOUT_SECONDS=5
# Required when persistence is enabled or a non-mock provider is selected.
# Generate locally with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# JARVIS_LOCAL_AUTH_TOKEN=
# Generate once and keep stable for this local owner:
# python -c "import uuid; print(uuid.uuid4())"
# JARVIS_OWNER_ID=
# Explicit long-term memory retrieval is off by default and requires persistence.
JARVIS_MEMORY_RETRIEVAL_ENABLED=false
JARVIS_MEMORY_RETRIEVAL_LIMIT=3
JARVIS_DOCUMENT_RETRIEVAL_LIMIT=2
# Bounded context assembly for persisted chats (character limits, not tokens).
# History turns from the same conversation; 0 disables history in prompts.
JARVIS_CONTEXT_HISTORY_MESSAGES=6
JARVIS_CONTEXT_EXCERPT_MAX_CHARS=1500
JARVIS_CONTEXT_MAX_CHARS=12000
# When enabled, set this in your ignored local .env; never place real credentials here.
# JARVIS_PERSISTENCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Browser intelligence (v2.6). Off by default; requires the local auth token and owner id.
JARVIS_BROWSER_ENABLED=false
# mock (offline demo pages) | http (no JavaScript) | playwright (optional package; not installed by default)
JARVIS_BROWSER_PROVIDER=http
# Only for local test pages; rejected in production.
JARVIS_BROWSER_ALLOW_PRIVATE_NETWORK=false
JARVIS_BROWSER_ALLOWED_DOMAINS=
JARVIS_BROWSER_BLOCKED_DOMAINS=
JARVIS_BROWSER_MAX_SESSIONS=2
JARVIS_BROWSER_SESSION_TTL_SECONDS=600
JARVIS_BROWSER_MAX_NAVIGATIONS=15
JARVIS_BROWSER_MAX_ACTIONS=40
JARVIS_BROWSER_NAVIGATION_TIMEOUT_SECONDS=15
JARVIS_BROWSER_MAX_PAGE_BYTES=2000000
JARVIS_BROWSER_MAX_TEXT_CHARS=20000
JARVIS_BROWSER_MAX_ELEMENTS=150
# Allows /browser/checks/run to open pages; independent of JARVIS_VERIFICATION_EXECUTION_ENABLED.
JARVIS_BROWSER_CHECKS_ENABLED=false

# Read-only tool runtime (v2.7). Off by default; requires the local auth token and owner id.
JARVIS_TOOLS_ENABLED=false
JARVIS_TOOLS_MAX_CONCURRENT=2
JARVIS_TOOLS_MAX_TIMEOUT_SECONDS=20
JARVIS_TOOLS_MAX_OUTPUT_BYTES=32768
JARVIS_TOOLS_MAX_ARGUMENT_BYTES=8192

# Action loop (v2.8): chat may propose read-only tool calls. Requires JARVIS_TOOLS_ENABLED=true.
JARVIS_CHAT_TOOLS_ENABLED=false
JARVIS_CHAT_TOOL_MAX_CALLS=4

# Approval gateway (v2.9): pending approval requests expire after this many seconds.
# Approving records the decision only; nothing is executed.
JARVIS_APPROVALS_TTL_SECONDS=900
